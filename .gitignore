# ---------------------------------------------------------------------------
# BarberShop monorepo — shared ignore rules
# ---------------------------------------------------------------------------

# --- secrets / local config -------------------------------------------------
.env
.env.*
!.env.example

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- editors ---------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp

# ---------------------------------------------------------------------------
# Python / Django  (services/api)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

.venv/
venv/

# `.python-version` is deliberately *not* ignored. It used to be, which meant
# the file existed on developer machines and not in CI: uv resolved 3.13 locally
# and 3.12 in CI, so the suite only ever ran on one of the two versions the
# project claims to support. Pinned and committed, both agree.

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# django — keep the empty directories, drop their contents
staticfiles/*
!staticfiles/.gitkeep
media/*
!media/.gitkeep
*.sqlite3
*.sqlite3-journal

# ---------------------------------------------------------------------------
# Node / React Native  (apps/mobile)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# metro / expo
.expo/
.expo-shared/
dist/
web-build/
*.jsbundle

# --- React Native / Expo native builds -------------------------------------
# generated
ios/Pods/
ios/build/
ios/*.xcworkspace
ios/.xcode.env.local
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.cxx/
*.keystore
!debug.keystore

# --- test / coverage -------------------------------------------------------
coverage/
*.lcov

# --- misc -------------------------------------------------------------------
*.log
tmp/
.cache/