# ---------------------------------------------------------------------------
# BarberShop mobile — environment
#
#   cp .env.example .env
#
# EXPO_PUBLIC_* variables are inlined into the JavaScript bundle at build time.
# Anything secret must NOT go here — the bundle is downloadable from the app
# store. Tokens live in expo-secure-store for exactly this reason.
# ---------------------------------------------------------------------------

# Base URL of the API, with no trailing slash.
#
#   iOS simulator       http://127.0.0.1:8000
#   Android emulator    http://10.0.2.2:8000
#   Physical device     http://<your-laptop-LAN-IP>:8000
#
# On a phone, 127.0.0.1 is the phone. Use your machine's LAN address.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Google Maps, only needed for the in-app map. Restrict it by bundle id and
# package name in the Google console before shipping.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
