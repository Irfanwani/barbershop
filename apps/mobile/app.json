{
  "expo": {
    "name": "BarberShop",
    "slug": "barbershop",
    "scheme": "barbershop",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "bundleIdentifier": "com.barbershop.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BarberShop uses your location to show you salons and barbers near you, and to sort them by distance.",
        "NSPhotoLibraryUsageDescription": "BarberShop needs access to your photos so you can use one as your profile picture or as a reference for a haircut.",
        "NSUserTrackingUsageDescription": "This app does not track you."
      }
    },
    "android": {
      "package": "com.barbershop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-foreground.png",
          "color": "#F97316"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BarberShop uses your location to show you salons and barbers near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BarberShop needs access to your photos so you can use one as your profile picture."
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}