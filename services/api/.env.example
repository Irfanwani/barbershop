# BarberShop API — environment template
#
#   cp .env.example .env
#
# Anything left blank is treated as unset. Production refuses to boot without
# the entries marked REQUIRED; development falls back to safe local defaults.
# ---------------------------------------------------------------------------

# --- core (REQUIRED in production) ------------------------------------------
# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# DEBUG is NOT read from here: config/settings/dev.py hardcodes True and
# base.py hardcodes False. Changing this line does nothing.

ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=True

# --- database (REQUIRED in production) --------------------------------------
# Needs PostgreSQL with the PostGIS extension available.
POSTGRES_DB=barbershop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
TEST_POSTGRES_DB=test_barbershop

# --- security ---------------------------------------------------------------
# Encrypts provider bank details at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: change this on a real deployment and store it in a secrets manager.
# Rotating it makes every previously-saved bank account number unreadable.
FIELD_ENCRYPTION_KEY=

# --- auth -------------------------------------------------------------------
AUTH_TOKEN_TTL_HOURS=168
AUTH_TOKEN_LIMIT_PER_USER=10
THROTTLE_RATE_AUTH=20/min
THROTTLE_RATE_PASSWORD_RESET=5/min
THROTTLE_RATE_BOOKING=30/min

# --- email (REQUIRED in production) -----------------------------------------
# Locally these print to the console and nothing is sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=BarberShop <no-reply@barbershop.local>

# --- payments (REQUIRED in production) --------------------------------------
# Live keys are only ever entered in production; use the test keys elsewhere.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Percentage added on top of the provider's price, shown as its own line.
PLATFORM_FEE_PERCENT=1

# --- media ------------------------------------------------------------------
# Set USE_S3=True and fill in the AWS block on a real deployment; uploads stay
# on local disk otherwise.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# --- push notifications -----------------------------------------------------
# A tiny service that fans an Expo push message out to a list of tokens.
# --- optional AI -----------------------------------------------------------
# Matching "I want it shorter but not shaved" to an actual service menu.
# Leave these blank and the app falls back to keyword matching. The model is
# only ever allowed to choose from a list the backend supplied; it never
# touches prices, payments or bookings.
AI_MODEL=
AI_API_KEY=
AI_ENDPOINT=

PUSH_NOTIFICATION_URL=

# --- Celery -----------------------------------------------------------------
# Redis is both broker and result backend. Without a worker running, the API
# works fine and sends no reminders at all.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=UTC

# --- misc -------------------------------------------------------------------
TIME_ZONE=UTC
LOG_LEVEL=INFO
DEFAULT_PAGE_SIZE=20


# --- WhatsApp (optional) ----------------------------------------------------
# Unset means bookings are confirmed by email only. There is no error and no
# log line louder than debug: an unconfigured provider is a silent no-op, so if
# you are expecting a WhatsApp message and getting none, check here first.
# WHATSAPP_PROVIDER is one of: twilio, msg91, gxt
WHATSAPP_PROVIDER=
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM=
# MSG91 only, and only for template sends.
WHATSAPP_TEMPLATE_ID=
# Shared secret the provider signs webhook bodies with.
WHATSAPP_WEBHOOK_SECRET=

# --- third-party API keys ---------------------------------------------------
# Rotating this invalidates every key already issued. Keys are stored hashed
# with this salt in front of them; without it a stolen database is a usable set
# of credentials.
API_KEY_SALT=
API_KEY_RATE_PER_MINUTE=60

# --- observability ----------------------------------------------------------
# No DSN is a supported configuration, not a broken one: errors are still
# logged as JSON carrying the request id, so a failed request stays findable.
# Set LOG_FORMAT=plain when you want to read a laptop's output.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_FORMAT=json

# --- geospatial libraries ---------------------------------------------------
# Leave blank to let Django find GEOS and GDAL itself. Set only if they live
# somewhere unusual; give the full path of each shared object. See the
# "Prerequisites" section of README.md — a missing library here fails as a
# GDAL import error rather than anything mentioning PostGIS.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# --- auth token tuning ------------------------------------------------------
AUTH_TOKEN_MIN_REFRESH_SECONDS=
AUTH_TOKEN_AUTO_REFRESH_MAX_LIMIT=
THROTTLE_RATE_PUBLIC_SEARCH=

# --- django deployment hardening --------------------------------------------
# Read by config/settings/prod.py. Left unset these default to off, which is
# fine behind a proxy that already redirects to HTTPS and sets HSTS.
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
NUM_PROXIES=

# --- misc gaps --------------------------------------------------------------
DJANGO_ENV=development
POSTGRES_CONNECT_TIMEOUT=10
EMAIL_TIMEOUT=10
CELERY_TASK_ALWAYS_EAGER=
PUBLIC_SITE_URL=
ANDROID_EMULATOR=
